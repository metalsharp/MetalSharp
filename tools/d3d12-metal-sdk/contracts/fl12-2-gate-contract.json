{
  "schema": "metalsharp.d3d12-metal.fl12-2-gate.v1",
  "purpose": "The single behavior-backed promotion gate for the D3D12 FL12_2 and project SM6.7 target.",
  "target": {
    "feature_level": "12_2",
    "shader_model": "6_7",
    "expected_levels": ["11_0", "11_1", "12_0", "12_1", "12_2"],
    "promotion_is_atomic": true
  },
  "evidence": [
    {
      "kind": "source",
      "path": "tools/d3d12-metal-sdk/probes/probe_feature_levels/probe_feature_levels.cpp",
      "note": "The feature-level probe performs all requested device creations and D3D12_OPTIONS queries."
    },
    {
      "kind": "aggregator",
      "path": "tools/d3d12-metal-sdk/scripts/validate-fl12-2-gate.py",
      "note": "The aggregator joins query results, behavior probes, and isolated runtime identity before promotion."
    },
    {
      "kind": "roadmap",
      "path": "docs/roadmaps/d3d12-fl12_2-sm67-dxr-completion-roadmap.md",
      "note": "Completion Phases 1–9 define the ordered behavior and delivery gates."
    }
  ],
  "identity": {
    "environment_result": "isolated-probe-environment",
    "host_runtime_result": "host-runtime",
    "wine_version": "wine-11.5",
    "required_artifacts": [
      "wine",
      "wineserver",
      "d3d10core",
      "d3d11",
      "d3d12",
      "dxgi",
      "dxgi_dxmt",
      "winemetal_pe",
      "winemetal_unix"
    ],
    "require_xcode_and_metal": true,
    "require_source_identity": true
  },
  "query_requirements": [
